@page "/settings"
@using MAF.UI.Services
@using MAF.Assistants.Models
@using MAF.Assistants.Utilities
@inject ChatService ChatService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Settings - AI Agent Chat</PageTitle>

<div class="settings-page">
    <div class="settings-header">
        <button class="back-button" @onclick="GoBack">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                <path d="M19 12H5M12 19l-7-7 7-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Back
        </button>
        <h1>Settings</h1>
    </div>

    <div class="settings-content">
        <div class="settings-section">
            <h2>General</h2>
            
            <div class="setting-item">
                <div class="setting-info">
                    <label>Test Mode</label>
                    <p>Simulate AI responses without backend connection and enable testing features</p>
                </div>
                <label class="toggle-switch">
                    <input type="checkbox" checked="@ChatService.Settings.IsTestMode" @onchange="HandleTestModeToggle" disabled="@isTogglingMode" />
                    <span class="toggle-slider"></span>
                </label>
            </div>
        </div>

        <div class="settings-section">
            <h2>Agent Selection</h2>
            
            <div class="setting-item-vertical">
                <div class="setting-info">
                    <label>Default Agent</label>
                    <p>Choose the AI agent personality and capabilities for new chats</p>
                </div>
                <div class="agent-dropdown-wrapper">
                    <select class="agent-select" @onchange="HandleAgentDropdownChange" disabled="@isTogglingMode" value="@ChatService.Settings.SelectedAgentType">
                        @foreach (var agentType in AgentTypeHelper.GetAllAgentTypes())
                        {
                            <option value="@agentType">@agentType.GetIcon() @agentType.GetDisplayName() - @agentType.GetFullDescription()</option>
                        }
                    </select>
                </div>
            </div>
        </div>

        <div class="settings-section">
            <h2>AI Configuration</h2>
            
            <div class="setting-item">
                <div class="setting-info">
                    <label>Cloud/Local Mode</label>
                    <p>@(ChatService.Settings.IsCloudMode ? "Using cloud-based AI service" : "Using local AI model")</p>
                    @if (isTogglingMode)
                    {
                        <p class="status-message">Initializing agent...</p>
                    }
                </div>
                <div class="mode-selector">
                    <button class="@(ChatService.Settings.IsCloudMode ? "active" : "")" @onclick="() => HandleModeSwitch(true)" disabled="@isTogglingMode">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                            <path d="M18 10h-1.26A8 8 0 109 20h9a5 5 0 000-10z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        Cloud
                    </button>
                    <button class="@(!ChatService.Settings.IsCloudMode ? "active" : "")" @onclick="() => HandleModeSwitch(false)" disabled="@isTogglingMode">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                            <rect x="2" y="3" width="20" height="14" rx="2" ry="2" stroke="currentColor" stroke-width="2"/>
                            <path d="M8 21h8M12 17v4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                        </svg>
                        Local
                    </button>
                </div>
            </div>
        </div>

        <div class="settings-section">
            <h2>Storage</h2>
            
            <div class="setting-item">
                <div class="setting-info">
                    <label>Chat History</label>
                    <p>@storagePath</p>
                </div>
                <button class="secondary-button" @onclick="HandleClearHistory">
                    Clear History
                </button>
            </div>

            <div class="setting-item">
                <div class="setting-info">
                    <label>Save Automatically</label>
                    <p>Save chat sessions automatically</p>
                </div>
                <label class="toggle-switch">
                    <input type="checkbox" checked="@autoSave" @onchange="HandleAutoSaveToggle" />
                    <span class="toggle-slider"></span>
                </label>
            </div>
        </div>

        <div class="settings-section">
            <h2>About</h2>
            
            <div class="setting-item">
                <div class="setting-info">
                    <label>Version</label>
                    <p>MAF.UI 1.0.0</p>
                </div>
            </div>

            <div class="setting-item">
                <div class="setting-info">
                    <label>Framework</label>
                    <p>.NET 9.0 Blazor Server</p>
                </div>
            </div>

            <div class="setting-item">
                <div class="setting-info">
                    <label>Created by</label>
                    <p>
                        Paul Bullock - <a href="https://pkbullock.com" target="_blank">pkbullock.com</a><br />
                        and credit to GitHub Copilot for all the help with coding!
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string storagePath = string.Empty;
    private bool autoSave = true;
    private bool isTogglingMode = false;

    protected override void OnInitialized()
    {
        storagePath = Path.Combine(
            Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData),
            "MAF.UI",
            "ChatHistory"
        );
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/");
    }

    private async Task HandleTestModeToggle(ChangeEventArgs e)
    {
        var isChecked = (bool)(e.Value ?? false);
        isTogglingMode = true;
        StateHasChanged();
        
        try
        {
            await ChatService.ToggleTestModeAsync(isChecked);
        }
        finally
        {
            isTogglingMode = false;
            StateHasChanged();
        }
    }

    private async Task HandleModeSwitch(bool isCloudMode)
    {
        if (isTogglingMode) return;
        
        isTogglingMode = true;
        StateHasChanged();
        
        try
        {
            await ChatService.SwitchModeAsync(isCloudMode);
        }
        finally
        {
            isTogglingMode = false;
            StateHasChanged();
        }
    }

    private async Task HandleClearHistory()
    {
        // TODO: Add confirmation dialog
        // For now, just navigate back
        await Task.CompletedTask;
    }

    private void HandleAutoSaveToggle(ChangeEventArgs e)
    {
        autoSave = (bool)(e.Value ?? false);
    }

    private async Task HandleAgentSelection(AgentType agentType)
    {
        if (isTogglingMode || ChatService.Settings.SelectedAgentType == agentType) 
            return;
        
        isTogglingMode = true;
        StateHasChanged();
        
        try
        {
            await ChatService.SwitchAgentAsync(agentType);
        }
        finally
        {
            isTogglingMode = false;
            StateHasChanged();
        }
    }

    private async Task HandleAgentDropdownChange(ChangeEventArgs e)
    {
        if (e.Value == null || isTogglingMode) return;
        
        if (Enum.TryParse<AgentType>(e.Value.ToString(), out var agentType))
        {
            await HandleAgentSelection(agentType);
        }
    }
}
